# Ansible runner (docker-compose service "ansible", app/playbooks/runner.py): the backend's Python environment plus
# ansible-core and the network collections. Only this image carries Ansible.
FROM python:3.15.1-slim-bookworm@sha256:575f8bc12ec26542e0678bc6b60e385218248019d433157ec327264a78c3a853
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections XDG_CACHE_HOME=/tmp/.cache
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /app siem
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY ansible/requirements.txt ansible/collections.yml ./ansible/
RUN pip install -r ansible/requirements.txt \
    && ansible-galaxy collection install -r ansible/collections.yml -p /usr/share/ansible/collections \
    && rm -rf /root/.ansible
COPY alembic.ini .
COPY migrations ./migrations
COPY app ./app
COPY rules ./rules
USER 10001
CMD ["python", "-m", "app.playbooks.runner"]
